          "id": "82518b9d-9065-4bb5-af61-8fab709920ea",
          "name": "List sequence recipients",
          "request": {
            "name": "List sequence recipients",
            "description": {
              "content": "Retrieves the activated recipients belonging to the specified sequence (draft recipients are excluded). This endpoint uses offset-based pagination and returns a single array of results (not the standard results/next envelope). You are limited to 10,000 total records.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sequences",
                ":id",
                "recipients"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Page size"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset into the result set (max total 10000)"
                }
              ],
              "variable": [
